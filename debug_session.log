 breakfast', 'no exercise', 'sugary foods', 'sleep deprived'], 'audio_file': 'C:\\Users\\dev\\youtube-auto\\storage\\tasks\\4e0ec209-3955-4aed-a191-ddc5b204c4ba\\audio.mp3', 'audio_duration': 107, 'subtitle_path': 'C:\\Users\\dev\\youtube-auto\\storage\\tasks\\4e0ec209-3955-4aed-a191-ddc5b204c4ba\\subtitle.srt', 'materials': ['C:\\Users\\dev\\youtube-auto\\storage\\cache_videos/vid-e5de6f245d260a7e4e83fb55eda4e9c1.mp4', 'C:\\Users\\dev\\youtube-auto\\storage\\cache_videos/vid-be6914092436d2ee8bc52b9288c72111.mp4', 'C:\\Users\\dev\\youtube-auto\\storage\\cache_videos/vid-706ce0b6be8399487b2f93690aaac632.mp4', 'C:\\Users\\dev\\youtube-auto\\storage\\cache_videos/vid-2a67e5058647177fceb24a552db26533.mp4', 'C:\\Users\\dev\\youtube-auto\\storage\\cache_videos/vid-48f589fccc0d4943bac7c0933bf95673.mp4', 'C:\\Users\\dev\\youtube-auto\\storage\\cache_videos/vid-0588a51d6f989845cc383813bce26193.mp4', 'C:\\Users\\dev\\youtube-auto\\storage\\cache_videos/vid-dafc568b9100c149182937ec75473aed.mp4', 'C:\\Users\\dev\\youtube-auto\\storage\\cache_videos/vid-8ec0fc131714a21ed4c07c4cf41d6e73.mp4', 'C:\\Users\\dev\\youtube-auto\\storage\\cache_videos/vid-f770d7dd93de3594848a1c23f02a26e4.mp4', 'C:\\Users\\dev\\youtube-auto\\storage\\cache_videos/vid-c9d01b054a63d4b5de47c17fc4921caa.mp4', 'C:\\Users\\dev\\youtube-auto\\storage\\cache_videos/vid-34875fbb449a1e57a0013f12b6acfe8c.mp4', 'C:\\Users\\dev\\youtube-auto\\storage\\cache_videos/vid-afe015a6510e3ef370362f8c6aec8021.mp4', 'C:\\Users\\dev\\youtube-auto\\storage\\cache_videos/vid-c9d01b054a63d4b5de47c17fc4921caa.mp4', 'C:\\Users\\dev\\youtube-auto\\storage\\cache_videos/vid-7ac905475a748bffdeac00dc50a024ce.mp4', 'C:\\Users\\dev\\youtube-auto\\storage\\cache_videos/vid-f770d7dd93de3594848a1c23f02a26e4.mp4', 'C:\\Users\\dev\\youtube-auto\\storage\\cache_videos/vid-afe015a6510e3ef370362f8c6aec8021.mp4', 'C:\\Users\\dev\\youtube-auto\\storage\\cache_videos/vid-01d5f242e062c8e4b46ca33f4908c754.mp4', 'C:\\Users\\dev\\youtube-auto\\storage\\